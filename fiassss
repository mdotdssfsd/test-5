---------------------------------------------------------
-- ANIMATION SPEED
---------------------------------------------------------

local animationConnection

local function getAnimationMultiplier()

    return FeatureState.PunchSpeed
        and FeatureState.PunchSpeedValue
        or 1
end

local function applyAnimationSpeed(track)

    if not track then
        return
    end

    pcall(function()

        track:AdjustSpeed(
            math.clamp(
                getAnimationMultiplier(),
                0.05,
                20
            )
        )
    end)
end

local function connectCharacterRuntime(character)

    if animationConnection then
        animationConnection:Disconnect()
        animationConnection = nil
    end

    local humanoid =
        character
        and character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    animationConnection =
        humanoid.AnimationPlayed:Connect(function(track)

            task.defer(function()
                applyAnimationSpeed(track)
            end)
        end)

    for _, track in ipairs(
        humanoid:GetPlayingAnimationTracks()
    ) do

        applyAnimationSpeed(track)
    end
end

local function updateAnimationSpeeds()

    local character = LocalPlayer.Character

    if not character then
        return
    end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    for _, track in ipairs(
        humanoid:GetPlayingAnimationTracks()
    ) do

        applyAnimationSpeed(track)
    end
end

LocalPlayer.CharacterAdded:Connect(function(character)

    task.wait(0.2)

    connectCharacterRuntime(character)
end)

if LocalPlayer.Character then
    connectCharacterRuntime(LocalPlayer.Character)
end

---------------------------------------------------------
-- GLIDE
---------------------------------------------------------

local function updateGlide()

    if not FeatureState.WeaveGlide then
        return
    end

    local character = LocalPlayer.Character

    if not character then
        return
    end

    local root =
        character:FindFirstChild("HumanoidRootPart")

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if not root
        or not humanoid
        or humanoid.Health <= 0 then

        return
    end

    local move = humanoid.MoveDirection

    if move.Magnitude > 0 then

        local strength =
            math.clamp(
                FeatureState.WeaveGlideStrength,
                1,
                10
            )

        root.AssemblyLinearVelocity =
            Vector3.new(
                move.X * 16 * strength,
                root.AssemblyLinearVelocity.Y,
                move.Z * 16 * strength
            )
    end
end

