        selectedTab == "SMOOVE"
        and "Smoove Users"
        or (
            selectedTab:sub(1, 1):upper()
            .. selectedTab:sub(2):lower()
        )

    HeaderSub.Text = tabSubtitles[selectedTab] or "controls"
