---------------------------------------------------------
-- HITBOX VISUALIZER
---------------------------------------------------------

local hitboxFolder = Instance.new("Folder")
hitboxFolder.Name = "5SmooveHub_HitboxVisuals"
hitboxFolder.Parent = workspace

local targetBoxes = {}

local function getCharacter(player)

    return player and player.Character
end

local function getRoot(player)

    local character = getCharacter(player)

    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(player)

    local character = getCharacter(player)

    return character and character:FindFirstChildOfClass("Humanoid")
end

local function isAlive(player)

    local humanoid = getHumanoid(player)
    local root = getRoot(player)

    return humanoid
        and humanoid.Health > 0
        and root ~= nil
end

local function clearTargetBox(player)

    local box = targetBoxes[player]

    if box then
        box:Destroy()
        targetBoxes[player] = nil
    end
end

local function updateTargetBox(player)

    if player == LocalPlayer then
        clearTargetBox(player)
        return
    end

    if not FeatureState.ShowHitbox then
        clearTargetBox(player)
        return
    end

    if not isAlive(player) then
        clearTargetBox(player)
        return
    end

    local character = getCharacter(player)

    if not character then
        clearTargetBox(player)
        return
    end

    local box = targetBoxes[player]

    if not box or not box.Parent then

        box = Instance.new("BoxHandleAdornment")

        box.Name = "Hitbox_" .. player.UserId

        -- Character-sized visual box
        box.Adornee = character

        -- Do NOT render through walls
        box.AlwaysOnTop = false

        box.ZIndex = 1

        -- Filled transparency
        box.Transparency = 0.65

        box.Color3 = FeatureState.HitboxColor

        box.Parent = hitboxFolder

        targetBoxes[player] = box
    end

    box.Adornee = character

    local sizeMultiplier = math.clamp(
        FeatureState.HitboxSize,
        1,
        10
    )

    box.Size = Vector3.new(
        4 * sizeMultiplier,
        6 * sizeMultiplier,
        2 * sizeMultiplier
    )

    box.Color3 = FeatureState.HitboxColor
    box.Transparency = 0.65
    box.AlwaysOnTop = false
end

local function refreshTargetBoxes()

    for _, player in ipairs(Players:GetPlayers()) do
        updateTargetBox(player)
    end

    for player in pairs(targetBoxes) do

        if not player.Parent then
            clearTargetBox(player)
        end
    end
end

