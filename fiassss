    DiamondKnob.BorderSizePixel = 0
    DiamondKnob.Parent = Fill

    if not isLocked then

        local sliding = false

        local function updateSlider(input)

            local mousePos = input.Position.X

            local trackPos =
                Track.AbsolutePosition.X

            local trackWidth =
                Track.AbsoluteSize.X

            local percent =
                math.clamp(
                    (mousePos - trackPos)
                    / trackWidth,
                    0,
                    1
